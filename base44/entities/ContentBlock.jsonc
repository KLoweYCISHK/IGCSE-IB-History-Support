{
  "name": "ContentBlock",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "paper1 | paper2 | paper3 | ia | ee | home"
    },
    "sub": {
      "type": "string",
      "description": "study | preparing | writing | markscheme | reflection | perspectives_intro"
    },
    "case_study": {
      "type": "string",
      "description": "hitler | castro | chiang | all"
    },
    "module": {
      "type": "string",
      "enum": [
        "russian_revolution",
        "cold_war",
        "all"
      ],
      "default": "all",
      "description": "paper3 unit filter (russian_revolution | cold_war | all). Untagged content is shared across both units."
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "table",
        "image",
        "link"
      ],
      "default": "text"
    },
    "title": {
      "type": "string"
    },
    "html": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "image_url": {
      "type": "string"
    },
    "image_layout": {
      "type": "string",
      "enum": [
        "full",
        "left",
        "right",
        "top"
      ],
      "default": "full",
      "description": "full = standalone; left = image left with text right; right = text left with image right; top = image on top with text below"
    },
    "image_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "full"
      ],
      "default": "full",
      "description": "Display size for the image (applies to full and top layouts). full = full container width."
    },
    "caption": {
      "type": "string"
    },
    "link_url": {
      "type": "string",
      "description": "URL for link blocks"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "section"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}