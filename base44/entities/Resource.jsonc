{
  "name": "Resource",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "paper1 | paper2 | paper3 | ia | ee"
    },
    "case_study": {
      "type": "string",
      "description": "hitler | castro | chiang | all"
    },
    "module": {
      "type": "string",
      "enum": [
        "russian_revolution",
        "cold_war",
        "all"
      ],
      "default": "all",
      "description": "paper3 module filter (russian_revolution | cold_war | all)"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file (PDF/Word) for file-based resources"
    },
    "file_name": {
      "type": "string",
      "description": "Original filename of the uploaded file"
    },
    "links": {
      "type": "array",
      "description": "Additional resources and links attached to this resource (e.g. links nested within a file)",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "link_username": {
      "type": "string",
      "description": "Optional login username for subscription/restricted resources"
    },
    "link_password": {
      "type": "string",
      "description": "Optional login password for subscription/restricted resources"
    },
    "submitted_by": {
      "type": "string"
    },
    "is_student_submission": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "section",
    "title"
  ],
  "rls": {
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}