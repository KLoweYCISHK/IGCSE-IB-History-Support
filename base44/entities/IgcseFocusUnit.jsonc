{
  "name": "IgcseFocusUnit",
  "type": "object",
  "properties": {
    "page": {
      "type": "string",
      "description": "igcse topic page this focus unit belongs to (igcse_core1 | igcse_core2 | igcse_depth)"
    },
    "focus_unit": {
      "type": "string",
      "description": "The inquiry question / focus unit title (first column)"
    },
    "bullet_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key bullet points for this focus unit (second column)"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "page",
    "focus_unit"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}