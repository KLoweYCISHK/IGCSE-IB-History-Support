{
  "name": "IgcseMarkSchemeTemplate",
  "type": "object",
  "properties": {
    "question_type": {
      "type": "string",
      "enum": [
        "4_marker",
        "6_marker",
        "10_marker"
      ],
      "description": "IGCSE Paper 1 question type this generic template applies to"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Generic mark scheme levels (first row is the header). Pre-fills every new question of this type."
    }
  },
  "required": [
    "question_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}