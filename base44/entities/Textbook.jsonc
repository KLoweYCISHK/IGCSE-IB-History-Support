{
  "name": "Textbook",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "paper1 | paper2 | paper3"
    },
    "case_study": {
      "type": "string",
      "default": "all",
      "description": "hitler | castro | chiang | postwar_europe | indochina_refugee | all"
    },
    "module": {
      "type": "string",
      "enum": [
        "russian_revolution",
        "cold_war",
        "all"
      ],
      "default": "all",
      "description": "paper3 module filter (russian_revolution | cold_war | all)"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "section",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}