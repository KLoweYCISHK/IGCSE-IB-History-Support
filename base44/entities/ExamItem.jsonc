{
  "name": "ExamItem",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "paper1 | paper2 | paper3"
    },
    "case_study": {
      "type": "string",
      "description": "hitler | castro | chiang | all"
    },
    "module": {
      "type": "string",
      "enum": [
        "russian_revolution",
        "cold_war",
        "all"
      ],
      "default": "all",
      "description": "paper3 unit filter for the question bank (russian_revolution | cold_war | all). Approach & mark schemes are always shared."
    },
    "category": {
      "type": "string",
      "enum": [
        "approach",
        "mark_scheme",
        "question"
      ],
      "default": "question",
      "description": "approach = how to approach + example; mark_scheme = mark scheme; question = bank of exam questions"
    },
    "question_type": {
      "type": "string",
      "description": "paper2: 6_marker | 4_marker | 15_marker"
    },
    "topic": {
      "type": "string",
      "description": "question bank topic filter, e.g. emergence, Tsarist policies"
    },
    "question": {
      "type": "string"
    },
    "time_minutes": {
      "type": "number",
      "description": "Suggested time to spend on this question (approach items). Shown as a bubble next to the question."
    },
    "approach": {
      "type": "string",
      "description": "rich text html"
    },
    "example": {
      "type": "string",
      "description": "rich text html"
    },
    "mark_scheme_rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Mark scheme as a table (first row is the header). Edited with the table editor."
    },
    "image_url": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "section",
    "question"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}