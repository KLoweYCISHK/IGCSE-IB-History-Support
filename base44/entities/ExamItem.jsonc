{
  "name": "ExamItem",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "paper1 | paper2 | paper3"
    },
    "case_study": {
      "type": "string",
      "description": "hitler | castro | chiang | all"
    },
    "question": {
      "type": "string"
    },
    "approach": {
      "type": "string",
      "description": "rich text html"
    },
    "example": {
      "type": "string",
      "description": "rich text html"
    },
    "mark_scheme": {
      "type": "string",
      "description": "rich text html"
    },
    "image_url": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "section",
    "question"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}