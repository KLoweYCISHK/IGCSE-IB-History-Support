{
  "name": "ExamItem",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "paper1 | paper2 | paper3"
    },
    "case_study": {
      "type": "string",
      "description": "hitler | castro | chiang | all"
    },
    "category": {
      "type": "string",
      "enum": [
        "approach",
        "mark_scheme",
        "question"
      ],
      "default": "question",
      "description": "approach = how to approach + example; mark_scheme = mark scheme; question = bank of exam questions"
    },
    "question_type": {
      "type": "string",
      "description": "paper2: 6_marker | 4_marker | 15_marker"
    },
    "topic": {
      "type": "string",
      "description": "question bank topic filter, e.g. emergence, Tsarist policies"
    },
    "question": {
      "type": "string"
    },
    "approach": {
      "type": "string",
      "description": "rich text html"
    },
    "example": {
      "type": "string",
      "description": "rich text html"
    },
    "mark_scheme": {
      "type": "string",
      "description": "rich text html"
    },
    "image_url": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "section",
    "question"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}